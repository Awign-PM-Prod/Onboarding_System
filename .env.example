# Used by docker compose when building the frontend image.
# These VITE_* values are baked into the JS bundle at build time.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Leave empty to use same-origin requests like /api/me through frontend Nginx.
# For split hosts / direct API access, set the backend origin only (no /api suffix).
# Example: http://13.204.206.236:8089
VITE_API_BASE_URL=
