# Secrets for Supabase Edge Functions (set via `supabase secrets set`, not committed).
# Never put Awign/SMS credentials in backend/.env — same pattern as RESEND_API_KEY for send-email-otp.
#
# Remaining-task digest (PM + Payroll Lead daily emails) — remaining-task-digest
# Deploy:
#   supabase secrets set CRON_SECRET=<long-random> FRONTEND_URL=https://your-frontend
#   supabase functions deploy remaining-task-digest
# Also set Vault secrets used by pg_cron (see migration 20260808150000_remaining_task_digest_cron.sql):
#   project_url, remaining_task_digest_cron_secret (same value as CRON_SECRET)
# Manual: POST /functions/v1/remaining-task-digest  Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=
# FRONTEND_URL=https://your-frontend
# RESEND_API_KEY is required on send-attendance-email (mailer reused by this digest).
#
# Mobile SMS OTP (Awign core-api) — send-mobile-otp
# Deploy (single secret = JWT access-token only, NOT the full curl):
#   supabase secrets set Mobile_OTP_KEY=eyJhbGciOiJIUzI1NiJ9...
#   supabase functions deploy send-mobile-otp
# Mobile_OTP_KEY=<JWT access-token only>
# Hardcoded in function: client, uid, x-caller-id=staffing_go, sender_id, channel, template_id, message template
#
# WhatsApp (360dialog) — onboarding invite only (send-onboarding-whatsapp)
# D360_API_KEY=<360dialog-api-key>
# WHATSAPP_COUNTRY_CODE=91
# Optional invite template:
# D360_TEMPLATE_NAME=your_invite_template
# D360_TEMPLATE_LANGUAGE=en
# D360_TEMPLATE_NAMESPACE=
# D360_TEMPLATE_URL_BUTTON_INDEX=0
#
# Partner KYC (PAN + bank verify) — tools.onxwork.com proxy
PARTNER_KYC_API_KEY=<team-api-key>
# Optional override (default: https://tools.onxwork.com/api/partner/kyc)
# PARTNER_KYC_BASE_URL=https://tools.onxwork.com/api/partner/kyc
#
# Retired for pan-verify / bank-verify (no longer used):
# SUREPASS_PAN_VERIFY_TOKEN=
# SUREPASS_BANK_VERIFY_TOKEN=
#
# Aadhaar (Neokred) — unchanged
# NEOKRED_CLIENT_USER_ID=
# NEOKRED_SECRET_KEY=
# NEOKRED_ACCESS_KEY=
