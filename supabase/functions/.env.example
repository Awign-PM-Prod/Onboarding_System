# Secrets for Supabase Edge Functions (set via `supabase secrets set`, not committed).
#
# Partner KYC (PAN + bank verify) — tools.onxwork.com proxy
PARTNER_KYC_API_KEY=<team-api-key>
# Optional override (default: https://tools.onxwork.com/api/partner/kyc)
# PARTNER_KYC_BASE_URL=https://tools.onxwork.com/api/partner/kyc
#
# Retired for pan-verify / bank-verify (no longer used):
# SUREPASS_PAN_VERIFY_TOKEN=
# SUREPASS_BANK_VERIFY_TOKEN=
#
# Aadhaar (Neokred) — unchanged
# NEOKRED_CLIENT_USER_ID=
# NEOKRED_SECRET_KEY=
# NEOKRED_ACCESS_KEY=
