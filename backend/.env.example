SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Super Admin bootstrap (no self-serve UI):
#   node scripts/create-super-admin.mjs
# Optional: --email you@company.com --name "Name" --password 'secret'
# Apply migration 20260805200000_super_admin_salary_activity.sql first.

# Docker / production: set production so demo OTP is off by default.
# Local npm run dev: leave unset or use development.
NODE_ENV=production
# Force demo/SMS regardless of NODE_ENV: MOBILE_OTP_DEMO=true|false
# Real SMS uses Supabase edge send-mobile-otp (Mobile_OTP_KEY secret there).
# Do NOT put Mobile_OTP_KEY in backend/.env when using edge-only.
MOBILE_OTP_DEMO=false

# Edge function names (must match deployed Supabase functions).
SEND_ONBOARDING_EMAIL_EDGE_FUNCTION=send-onboarding-email
SEND_EMAIL_OTP_EDGE_FUNCTION=send-email-otp
SEND_MOBILE_OTP_EDGE_FUNCTION=send-mobile-otp
SEND_ONBOARDING_WHATSAPP_EDGE_FUNCTION=send-onboarding-whatsapp
SEND_ATTENDANCE_EMAIL_EDGE_FUNCTION=send-attendance-email
# Reuses send-attendance-email (generic HTML mailer) unless you deploy a dedicated function:
SEND_REVIEW_STATUS_EMAIL_EDGE_FUNCTION=send-attendance-email
KYC_DOC_VALIDATE_EDGE_FUNCTION=kyc-document-validate
PAN_VERIFY_EDGE_FUNCTION=pan-verify
BANK_VERIFY_EDGE_FUNCTION=bank-verify
AADHAAR_SEND_OTP_EDGE_FUNCTION=aadhaar-send-otp
AADHAAR_VERIFY_OTP_EDGE_FUNCTION=aadhaar-verify-otp
# Set PARTNER_KYC_API_KEY / Neokred / RESEND / Mobile_OTP_KEY as Supabase edge secrets —
# see supabase/functions/.env.example.

WHATSAPP_COUNTRY_CODE=91
PORT=8089
# Local:
# CORS_ORIGIN=http://localhost:8088
# FRONTEND_URL=http://localhost:8088
# Production (Docker / ALB):
CORS_ORIGIN=https://staffing-portal.awignhub.in,http://localhost:8088
FRONTEND_URL=https://staffing-portal.awignhub.in
# Remaining-task digests run via Supabase Edge Function (remaining-task-digest), not this API.
# See supabase/functions/.env.example and migration 20260808150000_remaining_task_digest_cron.sql.
# Free-tier keep-alive: daily cheap SELECT from this API so the project does not pause.
# SUPABASE_KEEPALIVE_ENABLED=true
# SUPABASE_KEEPALIVE_MS=86400000
